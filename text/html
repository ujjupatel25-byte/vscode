<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Form Testing</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(to right, #ffecd2, #fcb69f);
      color: #333;
      padding: 20px;
    }

    h2 {
      color: #4b0082;
    }

    form {
      background: #fff;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      max-width: 400px;
    }

    label {
      display: block;
      margin-top: 10px;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border: 2px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    input:focus {
      border-color: #ff6600;
      outline: none;
    }

    button {
      margin-top: 15px;
      width: 100%;
      padding: 10px;
      background: #4b0082;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      cursor: pointer;
    }

    button:hover {
      background: #ff6600;
    }
  </style>
</head>
<body>
  <h2>Test Input Types</h2>
  <form>
    <label>Name:</label>
    <input type="text" placeholder="Enter your name">

    <label>Email:</label>
    <input type="email" placeholder="Enter your email">

    <label>Password:</label>
    <input type="password" placeholder="Enter password">

    <label>Number:</label>
    <input type="number" min="1" max="100">

    <label>Date:</label>
    <input type="date">

    <label>Color:</label>
    <input type="color">

    <label>File Upload:</label>
    <input type="file">

    <label>Range:</label>
    <input type="range" min="0" max="100">

    <button type="submit">Submit</button>
  </form>
</body>
</html>
